# Production Environment Configuration
# This file is used when running the application in production mode
# with direct connection to Neon Cloud Database

# Node.js Environment
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Database Configuration (Neon Cloud)
# Use your actual Neon Cloud database URL from https://console.neon.tech
# Example: postgres://username:password@ep-cool-darkness-123456.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=pon_tu_url_real_de_neon_aqui

# JWT Configuration
# Usa una cadena larga, aleatoria y muy difícil de adivinar (ej. generada con 'openssl rand -base64 32')
JWT_SECRET=pon_tu_clave_secreta_de_produccion_aqui_bien_larga

# Application Configuration
# Aquí puedes agregar otras variables que use tu app en la calle
# FRONTEND_URL=https://tu-dominio-real.com